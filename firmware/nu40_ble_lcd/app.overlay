/* Legacy NRF52BOOT 0.9.1 / S140 6.1.1 only. Preserve MBR, SD, NVS and bootloader. */
&lfclk {
	k32src = "rc";
	k32src-accuracy-ppm = <500>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};
&i2c0_default {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 0, 26)>, <NRF_PSEL(TWIM_SCL, 0, 27)>;
		bias-pull-up;
	};
};

&adc { status = "disabled"; };
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };
&pwm0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi3 { status = "disabled"; };
&ieee802154 { status = "disabled"; };

&flash0 {
	partitions {
		/delete-node/ partition@1000;
		/delete-node/ partition@10000;
		/delete-node/ partition@76000;
		slot0_partition: partition@26000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00026000 0x000b6000>;
		};
	};
};
