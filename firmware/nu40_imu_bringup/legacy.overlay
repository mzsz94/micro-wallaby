/* Apply after app.overlay for NRF52BOOT with S140 6.1.1.
 * Preserve MBR/SoftDevice below 0x26000 and NVS at 0xdc000..0xe0000.
 */
/* Legacy board revisions may lack a working 32.768 kHz crystal. */
&lfclk {
	k32src = "rc";
	k32src-accuracy-ppm = <500>;
};

&flash0 {
	partitions {
		/delete-node/ partition@1000;
		slot0_partition: partition@26000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00026000 0x000b6000>;
		};
	};
};
