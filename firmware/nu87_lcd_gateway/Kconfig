mainmenu "NU87 Wi-Fi to NU40 BLE LCD gateway"
source "Kconfig.zephyr"
menu "LCD gateway settings"
config GATEWAY_USB_HOST
	bool "Use the on-board USB-UART for HostPC data and control"
	depends on GATEWAY_NU40_KIT
	# The pinned LOGUART driver implements the IRQ API but omits this flag.
	select SERIAL_SUPPORT_INTERRUPT if UART_AMEBA_LOGUART
	select UART_INTERRUPT_DRIVEN
	default n
	help
	  Use authenticated CRC-protected serial RPC instead of the HTTP listener.
	  The shared Realtek RF initializes without AP association or DHCP.
config GATEWAY_IMU
	bool "Read an attached LSM6DS3/LSM6DS3TR-C over PA25/PA26"
	select I2C
	select GPIO
	select PINCTRL
	default n
choice GATEWAY_DISPLAY_PROTOCOL
	prompt "NU40 display firmware protocol"
	default GATEWAY_LCD_LEGACY
config GATEWAY_LCD_LEGACY
	bool "MZSZ-LCD / verified S140 legacy DFU"
config GATEWAY_NU40_KIT
	bool "NU40-KIT-DISPLAY with optional voice and authenticated SMP"
endchoice
config GATEWAY_PEER_ADDRESS
	string "Explicit NU40 LCD Bluetooth address (AA:BB:CC:DD:EE:FF)"
	default ""
config GATEWAY_PEER_ADDRESS_TYPE
	string "LCD Bluetooth address type (random or public)"
	default "random"
config GATEWAY_DFU_ADDRESS
	string "Explicit bootloader Bluetooth address; empty requires same LCD address"
	default ""
config GATEWAY_DFU_ADDRESS_TYPE
	string "Bootloader Bluetooth address type (random or public)"
	default "random"
config GATEWAY_WIFI_SSID
	string "Isolated test Wi-Fi SSID"
	default ""
config GATEWAY_WIFI_PSK
	string "Disposable test Wi-Fi PSK"
	default ""
config GATEWAY_WIFI_CHANNEL
	int "2.4 GHz AP channel (0 scans all channels)"
	range 0 14
	default 0
	help
	  Try the AP's observed channel on the first association attempt. Later
	  attempts scan all channels so a restarted hotspot can change channel.
	  Leave zero to scan all channels from the first attempt.
choice GATEWAY_WIFI_SECURITY
	prompt "Wi-Fi security"
	default GATEWAY_WIFI_SECURITY_OPEN
config GATEWAY_WIFI_SECURITY_OPEN
	bool "Open isolated test network"
config GATEWAY_WIFI_SECURITY_PSK
	bool "WPA2-PSK isolated test network"
endchoice
config GATEWAY_ALLOW_INSECURE_TEST_PSK
	bool "Acknowledge the AmebaD unverified entropy source for test WPA2"
	depends on GATEWAY_WIFI_SECURITY_PSK
	default n
config GATEWAY_WIFI_CONNECT_DELAY_MS
	int
	default 500
config GATEWAY_WIFI_CONNECT_RETRY_SECONDS
	int
	default 10
config GATEWAY_WIFI_CONNECT_TIMEOUT_SECONDS
	int
	default 60
config GATEWAY_WIFI_WORK_STACK_SIZE
	int
	default 4096
config GATEWAY_WIFI_WORK_PRIORITY
	int
	default 7
config GATEWAY_TIMER_STACK_SIZE
	int "Vendor software timer daemon stack size"
	range 2048 16384
	default 6144
config GATEWAY_HTTP_PORT
	int "HTTP port"
	range 1 65535
	default 8080
config GATEWAY_API_TOKEN
	string "Local API bearer token; empty disables mutating HTTP requests"
	default ""
config GATEWAY_NU40_PASSKEY
	string "Private six-digit NU40 pairing passkey (empty disables SMP relay)"
	depends on GATEWAY_NU40_KIT
	default ""
config GATEWAY_LOG_LEVEL
	int
	range 0 4
	default 3
endmenu
