/*
 * Legacy NU40-DK flash layout detected on this board:
 *   Adafruit nRF52 UF2 0.9.1 + SoftDevice S140 6.1.1
 *
 * The bootloader starts applications at 0x26000. Keep the application below
 * 0xED000, matching the legacy PCA10056-compatible BSP's safe limit.
 */

#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	zephyr,user {
		touch-d0-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		joystick-sw-gpios = <&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		io-channels = <&adc 1>, <&adc 2>, <&adc 4>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};
};

&flash0 {
	partitions {
		/delete-node/ partition@1000;
		/delete-node/ partition@10000;
		/delete-node/ partition@76000;
		/delete-node/ partition@dc000;

		slot0_partition: partition@26000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00026000 0x000c7000>;
		};
	};
};
